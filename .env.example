# Aurora Energy Platform - Environment Configuration

# Environment
ENV=dev

# AWS Configuration
AWS_REGION=eu-west-2
AWS_ACCOUNT_ID=123456789012

# S3 Buckets
S3_DATA_BUCKET=aurora-data-{env}
S3_MODELS_BUCKET=aurora-models-{env}
S3_REPORTS_BUCKET=aurora-reports-{env}
S3_CONFIG_BUCKET=aurora-config-{env}
S3_AUDIT_BUCKET=aurora-audit-{env}

# DynamoDB Tables
DYNAMODB_STATE_TABLE=aurora-agent-state-{env}
DYNAMODB_TASKS_TABLE=aurora-tasks-{env}

# SageMaker
SAGEMAKER_ROLE_ARN=arn:aws:iam::123456789012:role/SageMakerExecutionRole

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000

# OpenSearch
OPENSEARCH_ENDPOINT=https://search-aurora-dev.eu-west-2.es.amazonaws.com

# Cost Controls
DAILY_BUDGET_GBP=150.0

# Observability
LOG_LEVEL=INFO
OTEL_EXPORTER_ENDPOINT=http://localhost:4318

# Feature Flags
ENABLE_AUTO_RETRAIN=true
ENABLE_HUMAN_APPROVAL=true
ENABLE_COST_GATES=true
